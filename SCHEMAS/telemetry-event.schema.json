{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.grokbot-telemetry/schemas/telemetry-event.schema.json",
  "title": "GrokBotTelemetryEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "source"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 or local Europe/Paris labeled timestamp",
      "examples": [
        "2026-10-05T16:51:00+02:00"
      ]
    },
    "source": {
      "type": "string",
      "description": "Collector or subsystem name",
      "examples": [
        "shell",
        "process_sample",
        "fs_diff",
        "cli_inventory",
        "desktop",
        "mcp",
        "manual"
      ]
    },
    "pid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "ppid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cmdline": {
      "type": [
        "string",
        "null"
      ],
      "description": "Redact secrets inline if present"
    },
    "cwd": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "display": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        ":3"
      ]
    },
    "tool_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Agent tool concept e.g. Shell, Read, computerUse"
    },
    "files_touched": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "op"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete",
              "read",
              "chmod",
              "unknown"
            ]
          },
          "size": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "redaction_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What was redacted and why"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Command outputs paths, file paths, transcript refs"
    }
  }
}
